# 本地覆盖示例：复制为同目录 application-local.yml 后启动时加
#   --spring.profiles.active=local
# 或在 IDE Active profiles 填 local
# application-local.yml 已被 .gitignore，勿提交真实密钥
#
# 说明：若已在系统/IDE 环境变量里配置了 TFHERS_DB_PASSWORD、JWT_SECRET 等，
# 本文件可只覆盖你想改的少数项；下面是完整占位，便于本地一次性配齐。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/tfhers
    username: root
    password: 在此填写本地数据库密码

jwt:
  secret: 在此填写足够长的随机字符串

aliyun:
  oss:
    access-key-id: 在此填写
    access-key-secret: 在此填写
    bucket-name: tfhers
    endpoint: https://oss-cn-beijing.aliyuncs.com
    domain: https://tfhers.oss-cn-beijing.aliyuncs.com
  green:
    access-key-id: 在此填写
    access-key-secret: 在此填写

langchain4j:
  openai:
    chat-model:
      api-key: 在此填写
    streaming-chat-model:
      api-key: 在此填写

steam:
  api-key: 在此填写
  return-url: http://localhost:8081/api/user/steam/callback
  realm: http://localhost:8081
