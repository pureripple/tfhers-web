spring:
  datasource:
    url: jdbc:mysql://localhost:3306/tfhers
    username: root
    password: 鍦ㄦ濉啓鏈湴鏁版嵁搴撳瘑鐮?
jwt:
  secret: 鍦ㄦ濉啓瓒冲闀跨殑闅忔満瀛楃涓?
aliyun:
  oss:
    access-key-id: 鍦ㄦ濉啓
    access-key-secret: 鍦ㄦ濉啓
    bucket-name: tfhers
    endpoint: https://oss-cn-beijing.aliyuncs.com
    domain: https://tfhers.oss-cn-beijing.aliyuncs.com
  green:
    access-key-id: 鍦ㄦ濉啓
    access-key-secret: 鍦ㄦ濉啓

langchain4j:
  openai:
    chat-model:
      api-key: 鍦ㄦ濉啓
    streaming-chat-model:
      api-key: 鍦ㄦ濉啓

steam:
  api-key: 鍦ㄦ濉啓
  return-url: http://localhost:8081/api/user/steam/callback
  realm: http://localhost:8081

# 可选：覆盖 CORS（不设则用 application.yml / 环境变量）
