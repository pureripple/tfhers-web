# TFHers 鐜鍙橀噺娓呭崟锛堝鍒朵负 .env 鎴栧啓鍏ョ郴缁?systemd锛屽嬁鎻愪氦鐪熷疄瀵嗛挜锛?# 澶嶅埗鏈枃浠朵负 .env 鏃惰濉叆鐪熷疄鍊硷紱.env 宸茶 .gitignore 蹇界暐

# 鈥斺€?鏁版嵁搴擄紙app + management 鍏辩敤锛夆€斺€?TFHERS_DB_URL=jdbc:mysql://localhost:3306/tfhers
TFHERS_DB_USERNAME=root
TFHERS_DB_PASSWORD=

# 鈥斺€?JWT锛堜粎 management锛夆€斺€?JWT_SECRET=

# 鈥斺€?闃块噷浜?OSS 鈥斺€?ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=tfhers
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_DOMAIN=https://tfhers.oss-cn-beijing.aliyuncs.com

# 鈥斺€?闃块噷浜戝唴瀹瑰畨鍏?Green 鈥斺€?ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=
ALIYUN_GREEN_REGION_ID=cn-beijing
ALIYUN_GREEN_ENDPOINT=green.cn-beijing.aliyuncs.com
ALIYUN_GREEN_SERVICE=comment_detection
ALIYUN_GREEN_FAIL_OPEN=false

# 鈥斺€?閫氫箟 / LangChain4j 鈥斺€?LANGCHAIN4J_API_KEY=

# 鈥斺€?Steam 鈥斺€?STEAM_API_KEY=
# 下面两行是本地缺省（与 application.yml 一致）。生产不要用 localhost，
# 否则 Steam OpenID 的 return_to / realm 会把浏览器送回本机。
STEAM_RETURN_URL=http://localhost:8081/api/user/steam/callback
STEAM_REALM=http://localhost:8081

# —— 前端站点根（Steam 绑定成功后的 302 Location = {FRONTEND_BASE_URL}/settings）——
# 本地 Vite。生产不要用 localhost。
FRONTEND_BASE_URL=http://localhost:5173

# —— 生产（写入 env，替换上面的 localhost；当前演示站可用 IP）——
# STEAM_RETURN_URL=http://8.155.136.50/api/user/steam/callback
# STEAM_REALM=http://8.155.136.50
# FRONTEND_BASE_URL=http://8.155.136.50

# 鈥斺€?App 妯″潡锛氱鐞嗙鍦板潃 鈥斺€?TFHERS_MANAGEMENT_BASE_URL=http://localhost:8081
# --- CORS (app + management) ---
# Comma-separated frontend Origins. Do NOT use * in production.
# Demo: http://8.155.136.50
# Multi: http://8.155.136.50,https://www.example.com
# Without env: application.yml defaults to localhost list; profile=dev defaults to *
# CORS_ALLOWED_ORIGINS=