/* 蹄斗族群助手 - 暗色主题主样式文件 */

/* 重置和基础样式 */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --tfhers-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    --nav-height: 0px; /* top bar removed; left sidebar layout */
    --app-topbar-height: 56px;
    --mobile-topbar-height: 52px;
    --sidebar-width-expanded: 220px;
    --sidebar-width-collapsed: 68px;
    --sidebar-width: var(--sidebar-width-expanded);
    --radius-sm: 10px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --radius-xl: 28px;
    --radius-pill: 9999px;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-spring: cubic-bezier(0.34, 1.2, 0.64, 1);

    --bg-primary: #08080b;
    --bg-secondary: #111116;
    --bg-tertiary: #18181f;
    --bg-elevated: #1e1e27;
    --bg-quaternary: #25252e;

    /* 实色卡片表面（对齐教程角色卡，供比赛/大厅/排行等复用） */
    --card-surface: var(--bg-secondary);
    --card-surface-hover: var(--bg-elevated);
    --card-surface-inset: var(--bg-tertiary);

    --text-primary: #f3f3f6;
    --text-secondary: #a5a5b0;
    --text-muted: #6e6e7a;

    --accent-primary: #ff7a7a;
    --accent-secondary: #5fd9cc;
    --accent-tertiary: #7eb6ff;

    --border-color: rgba(255, 255, 255, 0.075);
    --border-strong: rgba(255, 255, 255, 0.12);

    /* 全站统一分割线（红→青点缀 + 两侧淡出） */
    --divider-h-gradient: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.07) 12%,
        rgba(255, 122, 122, 0.4) 50%,
        rgba(95, 217, 204, 0.28) 64%,
        rgba(255, 255, 255, 0.07) 88%,
        transparent 100%
    );
    --divider-v-gradient: linear-gradient(
        180deg,
        transparent 0%,
        rgba(255, 255, 255, 0.06) 8%,
        rgba(255, 122, 122, 0.32) 48%,
        rgba(95, 217, 204, 0.26) 52%,
        rgba(255, 255, 255, 0.06) 92%,
        transparent 100%
    );

    --shadow: rgba(0, 0, 0, 0.4);
    --shadow-hover: rgba(0, 0, 0, 0.55);
    --shadow-sm: 0 2px 16px rgba(0, 0, 0, 0.35);
    --shadow-md: 0 16px 48px rgba(0, 0, 0, 0.42);
    --shadow-lg: 0 28px 72px rgba(0, 0, 0, 0.5);
    --glow-accent: 0 0 48px rgba(255, 122, 122, 0.14);
}

body {
    font-family: var(--tfhers-font);
    line-height: 1.65;
    color: var(--text-primary);
    background-color: var(--bg-primary);
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
    letter-spacing: 0.01em;
    -webkit-font-smoothing: antialiased;
}

/* 全页背景图：使用 static/images/bg-app.png（可与 logo.png 一同替换） */
body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -2;
    background-image: url('/images/bg-app.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
}

/* 深色底 + 轻氛围光，保证可读 */
body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
        radial-gradient(ellipse 100% 70% at 50% -15%, rgba(255, 122, 122, 0.09), transparent 52%),
        radial-gradient(ellipse 55% 45% at 100% 35%, rgba(95, 217, 204, 0.06), transparent 42%),
        radial-gradient(ellipse 50% 40% at 0% 75%, rgba(126, 182, 255, 0.06), transparent 45%),
        linear-gradient(180deg, rgba(8, 8, 11, 0.88) 0%, rgba(8, 8, 11, 0) 100%);
}

/* Decorative full-page bg only on login/auth entry; logged-in app uses solid --bg-primary */
html.tfhers-authed body::before,
html.tfhers-authed body::after {
    display: none;
}


@property --sidebar-width {
    syntax: '<length>';
    inherits: true;
    initial-value: 220px;
}
/* ========== Logged-in left sidebar (pixiv-like structure, dark theme) ========== */
html.tfhers-authed {
    --nav-height: var(--app-topbar-height);
    --sidebar-width: var(--sidebar-width-expanded);
    transition: --sidebar-width 0.34s cubic-bezier(0.22, 1, 0.36, 1);
}

/* Fully hidden when collapsed: content uses full width */
html.tfhers-authed.sidebar-collapsed {
    --sidebar-width: 0px;
}

/* Floating cluster (hamburger + brand) when sidebar collapsed */
.sidebar-float-cluster {
    display: none;
}

html.tfhers-authed .sidebar-float-cluster {
    display: inline-flex;
    position: fixed;
    top: calc((var(--app-topbar-height) - 40px) / 2);
    left: 12px;
    z-index: 1200;
    align-items: center;
    gap: 10px;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    visibility: visible;
    /* No transform/opacity transition — brand row must stay pixel-stable across sidebar toggle */
    transition: none;
}

/* Keep float chrome always visible on desktop — one shared hamburger+brand, no crossfade jump */
html.tfhers-authed:not(.sidebar-collapsed) .sidebar-float-cluster {
    opacity: 1;
    transform: none;
    visibility: visible;
    pointer-events: auto;
}

.sidebar-float-toggle {
    display: none;
}

html.tfhers-authed .sidebar-float-toggle {
    display: inline-flex;
    position: static;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--text-primary);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
    transition: background 0.22s var(--ease-out), border-color 0.22s var(--ease-out);
}

html.tfhers-authed .sidebar-float-toggle:hover {
    background: rgba(30, 30, 39, 0.95);
    border-color: var(--border-strong);
}

html.tfhers-authed .sidebar-float-toggle i {
    font-size: 16px;
}

.sidebar-float-brand {
    font-family: inherit;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    user-select: none;
    pointer-events: none;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
    opacity: 0.95;
}

/* ========== App top bar (actions right) ========== */
.app-topbar {
    display: none;
}

html.tfhers-authed .app-topbar {
    display: flex;
    position: fixed;
    top: 0;
    left: var(--sidebar-width);
    right: 0;
    height: var(--app-topbar-height);
    z-index: 1150;
    align-items: center;
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(18px) saturate(1.15);
    -webkit-backdrop-filter: blur(18px) saturate(1.15);
    border-bottom: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    transition: left 0.34s cubic-bezier(0.22, 1, 0.36, 1);
    padding-left: 0;
}

html.tfhers-authed .app-topbar[hidden] {
    display: none !important;
}

/* Leave room for float hamburger+brand when sidebar is collapsed */
html.tfhers-authed.sidebar-collapsed .app-topbar {
    left: 0;
    padding-left: 118px;
}

.app-topbar-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    height: 100%;
    padding: 0 16px 0 14px;
    box-sizing: border-box;
}

.app-top-actions {
    display: none;
}

html.tfhers-authed .app-top-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    position: static;
    margin-left: auto;
    flex-shrink: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
}

html.tfhers-authed .app-top-actions[hidden] {
    display: none !important;
}

.top-post-wrap {
    position: relative;
}

.top-post-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px 0 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: var(--accent-primary);
    color: #1a0f10;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.22s var(--ease-out), transform 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out);
}

.top-post-btn:hover {
    background: #ff9191;
    transform: translateY(-1px);
}

.top-post-btn:active {
    transform: translateY(0);
}

.top-post-btn .fa-pen {
    font-size: 12px;
}

.top-post-btn .fa-caret-down {
    font-size: 11px;
    opacity: 0.85;
}

.top-post-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 132px;
    padding: 6px;
    border-radius: 12px;
    background: rgba(22, 22, 30, 0.98);
    border: 1px solid var(--border-strong);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top left;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out), visibility 0.2s;
    z-index: 1160;
}

.top-post-wrap.is-open .top-post-menu,
.top-post-menu:not([hidden]) {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    visibility: visible;
}

/* Keep [hidden] attribute but animate via .is-open on wrap */
.top-post-wrap.is-open .top-post-menu[hidden] {
    display: block;
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    visibility: visible;
}

.top-post-item {
    display: block;
    width: 100%;
    text-align: left;
    padding: 10px 12px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s var(--ease-out), color 0.18s var(--ease-out);
}

.top-post-item:hover {
    background: rgba(255, 122, 122, 0.14);
    color: #ffb0b0;
}

.top-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
}

.top-icon-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    border-color: var(--border-color);
}

.top-icon-btn i {
    font-size: 15px;
}

.top-avatar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 2px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: var(--bg-tertiary);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), transform 0.2s var(--ease-out);
}

.top-avatar-btn:hover {
    border-color: rgba(255, 122, 122, 0.65);
    box-shadow: 0 0 0 3px rgba(255, 122, 122, 0.18);
    transform: scale(1.04);
}

.top-avatar-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.top-avatar-wrap {
    position: relative;
}

.top-avatar-btn.is-open,
.top-avatar-wrap.is-open .top-avatar-btn {
    border-color: rgba(255, 122, 122, 0.65);
    box-shadow: 0 0 0 3px rgba(255, 122, 122, 0.18);
}

.top-account-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 300px;
    max-height: min(78vh, 640px);
    overflow-y: auto;
    padding: 14px;
    border-radius: 14px;
    background: rgba(18, 18, 26, 0.98);
    border: 1px solid var(--border-strong);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    z-index: 1160;
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top right;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out), visibility 0.2s;
}

.top-avatar-wrap.is-open .top-account-panel,
.top-account-panel:not([hidden]) {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    visibility: visible;
}

.top-avatar-wrap.is-open .top-account-panel[hidden] {
    display: block;
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    visibility: visible;
}

.tap-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
}

.tap-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.14);
    background: var(--bg-tertiary);
    flex-shrink: 0;
}

.tap-names { min-width: 0; flex: 1; }

.tap-nickname {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.tap-username {
    margin-top: 2px;
    font-size: 12px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.tap-section {
    padding: 12px 0;
    border-bottom: 1px solid var(--border-color);
}


.tap-rating-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}
.tap-rating { display: flex; align-items: center; gap: 8px; min-width: 0; }

.tap-tier {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
    background: rgba(160, 160, 160, 0.18);
    color: #c0c0c0;
}
.tap-tier.tier-D { background: rgba(205, 127, 50, 0.22); color: #cd7f32; }
.tap-tier.tier-C { background: rgba(192, 192, 192, 0.2); color: #c0c0c0; }
.tap-tier.tier-B { background: rgba(232, 213, 163, 0.2); color: #e8d5a3; }
.tap-tier.tier-A { background: rgba(255, 77, 79, 0.22); color: #ff4d4f; }
.tap-tier.tier-S { background: rgba(255, 196, 0, 0.22); color: #ffc400; }

.tap-score { font-size: 14px; font-weight: 700; color: var(--text-primary); }
.tap-rank {
    margin-left: auto;
    flex: 0 0 auto;
    text-align: right;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
}



.my-data-rating-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
}
.my-data-rating { display: flex; align-items: center; gap: 10px; min-width: 0; }
.my-data-score { font-size: 1.05rem; font-weight: 700; color: var(--text-primary); }
.my-data-rank {
    margin-left: auto;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
}
.my-stats-card.is-highlight {
    box-shadow: 0 0 0 2px rgba(255, 122, 122, 0.55), 0 8px 28px rgba(0, 0, 0, 0.25);
    transition: box-shadow 0.35s var(--ease-out);
}

.tap-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 10px;
}

.tap-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: background 0.18s var(--ease-out), color 0.18s var(--ease-out);
}

.tap-action-btn i { width: 16px; color: var(--text-secondary); }
.tap-action-btn:hover { background: rgba(255, 122, 122, 0.12); color: #ffb0b0; }
.tap-action-btn:hover i { color: #ffb0b0; }

.settings-subsection {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
}

.settings-subsection-title {
    margin: 0 0 12px;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
}

.settings-notify-list { display: flex; flex-direction: column; gap: 10px; }

.settings-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-size: 13px;
}

.settings-bind-block { margin-bottom: 18px; }
.settings-bind-steam-status {
    margin-bottom: 10px;
    font-size: 13px;
    color: var(--text-secondary);
}



.app-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--sidebar-width-expanded);
    z-index: 1100;
    display: flex;
    flex-direction: column;
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border-right: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.34s ease, visibility 0.34s;
    overflow: hidden;
    transform: translateX(0);
    visibility: visible;
    will-change: transform;
}

/* Desktop collapsed: entire sidebar off-screen */
html.tfhers-authed.sidebar-collapsed .app-sidebar {
    transform: translateX(-100%);
    visibility: hidden;
    pointer-events: none;
    box-shadow: none;
}

.sidebar-top {
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--app-topbar-height);
    min-height: var(--app-topbar-height);
    padding: 0 12px;
    border-bottom: 1px solid var(--border-color);
    flex-shrink: 0;
}

/* Desktop: hide in-sidebar hamburger+brand; float cluster is the only chrome */
@media (min-width: 769px) {
    html.tfhers-authed .sidebar-top .sidebar-toggle,
    html.tfhers-authed .sidebar-top .sidebar-brand {
        visibility: hidden;
        pointer-events: none;
    }
}

.sidebar-toggle {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition: background 0.22s var(--ease-out), border-color 0.22s var(--ease-out), color 0.22s var(--ease-out);
}

.sidebar-toggle:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border-color);
}

.sidebar-toggle i {
    font-size: 16px;
}

.sidebar-brand {
    font-family: inherit;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    user-select: none;
}

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 10px;
    overflow-y: auto;
    overflow-x: hidden;
    flex: 1 1 auto;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 12px;
    transition: color 0.22s var(--ease-out), background 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out);
    font-weight: 500;
    font-size: 0.92rem;
    position: relative;
    white-space: nowrap;
    min-height: 44px;
}

.nav-link span {
    overflow: hidden;
}

.nav-link:hover,
.nav-link.active {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
}

.nav-link.active {
    background: rgba(255, 122, 122, 0.12);
    box-shadow: 0 0 0 1px rgba(255, 122, 122, 0.22) inset;
}

.nav-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: linear-gradient(180deg, var(--accent-primary), var(--accent-secondary));
}

.nav-link i {
    font-size: 16px;
    width: 22px;
    text-align: center;
    flex-shrink: 0;
    opacity: 0.9;
}

.nav-link-ai.nav-link.active,
.nav-link-ai.nav-link:hover {
    background: linear-gradient(135deg, rgba(255, 122, 122, 0.12), rgba(95, 217, 204, 0.08));
    box-shadow: 0 0 0 1px rgba(255, 122, 122, 0.2) inset;
}

/* legacy unused */
.nav-toggle,
.nav-container,
.nav-brand,
.navbar {
    display: none !important;
}

.sidebar-backdrop {
    display: none;
}

.mobile-topbar {
    display: none;
}

/* Main content: full width when collapsed (--sidebar-width: 0) */
.main-content {
    margin-top: var(--nav-height);
    margin-left: var(--sidebar-width);
    min-height: calc(100vh - var(--nav-height));
    min-height: calc(100dvh - var(--nav-height));
    padding: 36px 0 56px;
    transition: margin-left 0.34s cubic-bezier(0.22, 1, 0.36, 1), margin-top 0.34s cubic-bezier(0.22, 1, 0.36, 1);
}

.page {
    display: none;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(18px, 4vw, 28px);
}

.page.active {
    display: block;
}



@media (prefers-reduced-motion: no-preference) {
    .page.active {
        animation: tfhers-page-enter 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
}

@keyframes tfhers-page-enter {
    from {
        opacity: 0;
        transform: translateY(14px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .page.active {
        animation: none;
    }
}

/* 资讯 / 教程网格项：由 JS 在渲染后添加 .u-stagger-in 与 animation-delay */
@media (prefers-reduced-motion: no-preference) {
    .u-stagger-in {
        animation: tfhers-grid-item-in 0.48s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
}

@keyframes tfhers-grid-item-in {
    from {
        opacity: 0;
        transform: translateY(16px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

#news.page {
    max-width: none;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
}

.page-header {
    text-align: center;
    margin-bottom: 60px;
}

.page-title {
    font-size: 3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
}

/* 文章网格（桌面三列；断点见 responsive.css） */
.articles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.5vw, 28px);
    margin-bottom: 56px;
}

.article-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out), border-color 0.35s var(--ease-out);
    cursor: pointer;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    will-change: transform;
}

.article-card--glass {
    background: rgba(17, 17, 22, 0.45);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
}

.article-card-media {
    position: relative;
    width: 100%;
    min-height: 240px;
    height: 260px;
    background: var(--bg-tertiary);
    overflow: hidden;
}

.article-card--glass .article-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
}

@media (prefers-reduced-motion: no-preference) {
    .article-card--glass:hover .article-cover {
        transform: scale(1.06);
    }
}

.article-card-glass {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    padding: 16px 18px;
    border-radius: var(--radius-lg);
    background: rgba(10, 10, 14, 0.52);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.article-card--glass .article-card-author {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
}

.article-card--glass .article-author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(0, 0, 0, 0.2);
}

.article-card--glass .article-author-name {
    font-size: 0.88rem;
    font-weight: 500;
    color: #d4d8e0;
    line-height: 1.3;
}

.article-card--glass .article-card-author-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.article-card--glass .article-card-time {
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(180, 188, 200, 0.85);
    line-height: 1.2;
}

.article-card--glass .article-card-title {
    font-weight: 700 !important;
    margin-bottom: 6px !important;
    color: #f3f5f8 !important;
    font-size: 1.12rem !important;
    line-height: 1.35 !important;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.article-card--glass .article-card-summary {
    font-size: 0.82rem !important;
    color: rgba(230, 234, 242, 0.88) !important;
    line-height: 1.45 !important;
    margin: 0 !important;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.article-card--glass:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg), var(--glow-accent);
    border-color: rgba(255, 122, 122, 0.22);
}

.article-card-body {
    order: 0;
}

.article-card-author {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
}

.article-author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
}

.article-author-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.3;
}

.article-card-title {
    font-weight: 700 !important;
    margin-bottom: 8px !important;
}

.article-card-summary {
    font-size: 0.85rem !important;
    color: var(--text-muted) !important;
    line-height: 1.5 !important;
}

.article-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg), var(--glow-accent);
    border-color: rgba(255, 122, 122, 0.3);
}

.article-cover-container {
    position: relative;
    width: 100%;
    height: 200px;
    background: var(--bg-tertiary);
    overflow: hidden;
    order: 1;
    flex-shrink: 0;
}

.article-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.article-cover-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: var(--bg-tertiary);
}

.article-cover-placeholder i {
    font-size: 2rem;
    margin-bottom: 8px;
}

.article-cover-placeholder span {
    font-size: 0.9rem;
}

.article-content {
    padding: 24px;
}

.article-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.4;
}

.article-meta {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 12px;
}

.article-excerpt {
    color: var(--text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* 资讯页：热门与最新共用版心 */
.news-page-wrap {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    width: 100%;
    box-sizing: border-box;
}

.hot-news-hero-inner {
    padding-top: 28px;
    padding-bottom: 8px;
}

/* 热门资讯 + 最新资讯与搜索 */
.hot-news-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.hot-news-hero {
    width: 100%;
    box-sizing: border-box;
}

.hot-news-split {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) 1px minmax(220px, 0.95fr);
    gap: 0 24px;
    align-items: stretch;
}

.hot-news-split-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.hot-news-split-pinned {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.hot-news-split-divider {
    width: 1px;
    min-width: 1px;
    background: var(--divider-v-gradient);
}

/* 热门 / 置顶 / 最新资讯：标题字号统一 */
.hot-news-block-title,
.news-latest-title {
    font-size: clamp(1.3rem, 2.9vw, 1.62rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--text-primary);
    line-height: 1.25;
}

.hot-news-block-title {
    margin: 0 0 16px;
}

.hot-news-block-title--pinned {
    display: flex;
    align-items: center;
    gap: 8px;
}

.hot-news-block-title--pinned i {
    color: var(--accent-primary);
    font-size: 0.95em;
    transform: rotate(45deg);
}

.pinned-news-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
}

.pinned-news-empty {
    padding: 20px 14px;
    text-align: center;
    font-size: 0.88rem;
    color: var(--text-muted);
    background: var(--bg-secondary);
    border: 1px dashed var(--border-color);
    border-radius: 12px;
    line-height: 1.5;
}

.pinned-news-item {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    text-align: left;
}

.pinned-news-item:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 6px 20px var(--shadow-hover);
    transform: translateY(-2px);
}

.pinned-news-thumb {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
}

.pinned-news-text {
    min-width: 0;
    flex: 1;
}

.pinned-news-item-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.pinned-news-item-meta {
    margin-top: 4px;
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hot-news-hero-body {
    display: flex;
    flex-direction: column;
}

.hot-news-hero-body .hot-news-wrap {
    flex-direction: column;
    width: 100%;
    max-width: none;
    margin: 0;
}

.hot-news-wrap {
    display: flex;
    flex-direction: column;
}

.hot-news-hero .hot-news-carousel {
    position: relative;
    height: min(50vh, 540px);
    aspect-ratio: 16 / 9;
    width: 100%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
}

.hot-news-hero .hot-news-slider-outer {
    position: absolute;
    inset: 0;
    display: block;
}

.hot-news-hero .hot-news-nav {
    position: absolute;
    top: 50%;
    z-index: 5;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(18, 20, 26, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #f3f5f8;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
}

.hot-news-hero .hot-news-nav-prev {
    left: 8px;
}

.hot-news-hero .hot-news-nav-next {
    right: 8px;
}

.hot-news-hero .hot-news-nav:hover {
    background: rgba(28, 32, 42, 0.75);
    border-color: var(--accent-primary);
    color: #fff;
}

.hot-news-hero .hot-news-nav:active {
    transform: translateY(-50%) scale(0.94);
}

.hot-news-hero .hot-news-nav:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
}

.hot-news-hero .hot-news-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--bg-tertiary);
    box-shadow: var(--shadow-md);
}

.hot-news-hero .hot-news-dots {
    flex-shrink: 0;
    padding: 12px 0 4px;
    margin-top: 0;
}

.news-latest-wrap {
    padding-top: 28px;
    padding-bottom: 48px;
    margin-top: 4px;
    position: relative;
}

/* 热门/置顶区域 与 「最新资讯」之间的分隔（与全站 --divider-h-gradient 一致） */
.news-latest-wrap::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--divider-h-gradient);
    pointer-events: none;
}

.news-latest-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 20px;
    margin-bottom: 24px;
}

.news-latest-title {
    margin: 0;
}

.news-latest-search {
    flex: 1 1 220px;
    min-width: 0;
    max-width: 360px;
}

.hot-news-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
}

.hot-news-search-icon {
    position: absolute;
    left: 12px;
    color: var(--text-muted);
    font-size: 0.9rem;
    pointer-events: none;
    z-index: 1;
}

.hot-news-search-input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 40px 11px 38px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.hot-news-search-input::placeholder {
    color: var(--text-muted);
    opacity: 0.85;
}

.hot-news-search-input:focus {
    border-color: rgba(255, 122, 122, 0.45);
    box-shadow: 0 0 0 3px rgba(255, 122, 122, 0.12);
}

.hot-news-search-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 8px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
}

.hot-news-search-clear:hover {
    background: var(--border-color);
    color: var(--text-primary);
}

.hot-news-slider {
    position: relative;
    overflow: hidden;
    background: var(--bg-secondary);
    min-height: 220px;
}

.hot-news-track {
    display: block;
}

.hot-news-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
    overflow: hidden;
    cursor: pointer;
    z-index: 0;
    pointer-events: none;
}

.hot-news-item.active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
}

.hot-news-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.hot-news-hero .hot-news-cover {
    object-fit: contain;
    object-position: center;
}

.hot-news-overlay {
    position: absolute;
    left: clamp(12px, 3vw, 20px);
    right: clamp(12px, 3vw, 20px);
    bottom: clamp(12px, 3vw, 20px);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(12, 14, 19, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16);
}

.hot-news-author-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.28);
    flex-shrink: 0;
}

.hot-news-meta {
    min-width: 0;
}

.hot-news-author {
    color: #d4d8e0;
    font-size: 0.85rem;
}

.hot-news-title {
    color: #f3f5f8;
    font-size: clamp(0.95rem, 2.5vw, 1.15rem);
    font-weight: 700;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hot-news-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
}

.hot-news-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-muted);
    opacity: 0.45;
    border: none;
    padding: 0;
    cursor: pointer;
}

.hot-news-dot.active {
    opacity: 1;
    background: var(--accent-primary);
}

@media screen and (max-width: 900px) {
    .hot-news-split {
        grid-template-columns: 1fr;
        gap: 20px 0;
    }

    .hot-news-split-divider {
        width: 100%;
        min-width: 0;
        height: 1px;
        min-height: 1px;
        background: var(--divider-h-gradient);
    }

    .hot-news-block-title {
        margin-bottom: 12px;
    }
}

@media screen and (max-width: 640px) {
    .news-latest-bar {
        flex-direction: column;
        align-items: stretch;
    }

    .news-latest-search {
        max-width: none;
    }

    .hot-news-hero .hot-news-nav {
        width: 36px;
        height: 36px;
    }

    .hot-news-hero .hot-news-carousel {
        height: min(42vh, 320px);
    }

    .pinned-news-thumb {
        width: 52px;
        height: 52px;
    }
}

/* 角色网格 */
.characters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 80px;
}

.character-card {
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
    text-align: center;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out), border-color 0.35s var(--ease-out);
    cursor: pointer;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    will-change: transform;
}

.character-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary), var(--accent-tertiary));
    opacity: 0;
    transition: opacity 0.3s ease;
}

.character-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg), var(--glow-accent);
    border-color: rgba(255, 122, 122, 0.35);
}

.character-card:hover::before {
    opacity: 1;
}

.character-avatar-container {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 20px;
}

.character-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border-color);
    transition: all 0.3s ease;
}

.character-avatar-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    border-radius: 50%;
    border: 3px solid var(--border-color);
    font-size: 2rem;
}

.character-card:hover .character-avatar {
    border-color: var(--accent-primary);
    transform: scale(1.05);
}

.character-name {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
}

/* 教程区域 */
.tutorial-section {
    margin-top: 80px;
    padding-top: 60px;
    border-top: 1px solid var(--border-color);
}

.section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 50px;
    position: relative;
}

.section-title::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    border-radius: 2px;
}

.tutorial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.tutorial-card {
    background: var(--bg-secondary);
    border-radius: 16px;
    padding: 40px 30px;
    text-align: center;
    transition: all 0.3s ease;
    border: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
}

.tutorial-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
}

.tutorial-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px var(--shadow-hover);
}

.tutorial-card:hover::before {
    opacity: 0.1;
}

.tutorial-icon {
    font-size: 3rem;
    color: var(--accent-primary);
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
}

.tutorial-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
}

.tutorial-desc {
    color: var(--text-secondary);
    line-height: 1.6;
    position: relative;
    z-index: 1;
}

/* 按钮样式 */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    border: none;
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), filter 0.25s var(--ease-out), border-color 0.25s var(--ease-out);
    font-size: 0.94rem;
}

.btn-primary {
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
    color: #0c0c10;
    box-shadow: 0 4px 20px rgba(255, 122, 122, 0.28);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(255, 122, 122, 0.35);
    filter: brightness(1.05);
}

@media (prefers-reduced-motion: no-preference) {
    .btn-primary:active {
        transform: scale(0.98) translateY(-1px);
    }
}

.btn-outline {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
}

.btn-outline:hover {
    border-color: rgba(255, 122, 122, 0.45);
    color: var(--text-primary);
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.06);
}

/* 模态框样式 */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(4, 4, 8, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 2000;
}

.article-modal-hide-title {
    display: none;
}

#articleModal .modal-header h3 {
    display: none;
}

/* 资讯弹窗：加宽容器 + 内部分栏各自滚动，整体不再滚动 */
#articleModal .modal-content.article-modal-content {
    position: relative;
    width: min(1180px, 96vw);
    max-width: 96vw;
    height: min(820px, 92vh);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translate(-50%, -50%);
}

#articleModal .modal-body.article-modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    padding: 0;
}

.article-modal-split {
    display: flex;
    align-items: stretch;
    height: 100%;
    min-height: 0;
}

.article-modal-pane {
    min-height: 0;
    box-sizing: border-box;
}

.article-modal-pane--comments {
    flex: 0 0 min(360px, 34vw);
    max-width: 400px;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 18px 16px 22px;
    border-right: none;
    background: rgba(8, 10, 14, 0.55);
    position: relative;
}

.article-modal-pane--comments::after {
    content: '';
    position: absolute;
    top: 4%;
    bottom: 4%;
    right: 0;
    width: 1px;
    background: var(--divider-v-gradient);
    pointer-events: none;
}

.article-modal-pane--article {
    flex: 1 1 0;
    min-width: 0;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 20px 22px 28px;
}

.article-modal-pane--article .article-detail-cover-img {
    max-height: min(48vh, 420px);
    min-height: min(24vh, 180px);
}

.article-modal-pane--article .article-detail-cover-wrap {
    min-height: min(28vh, 220px);
}

/* 资讯弹窗：封面与摘要/正文之间的分隔线 */
.article-modal-pane--article .article-detail-summary {
    margin-top: 22px;
    padding-top: 22px;
    position: relative;
}

.article-modal-pane--article .article-detail-summary::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--divider-h-gradient);
    pointer-events: none;
}

@media (max-width: 900px) {
    #articleModal .modal-content.article-modal-content {
        width: min(100vw - 16px, 96vw);
        height: min(90vh, 900px);
        max-height: 92vh;
    }

    .article-modal-split {
        flex-direction: column;
    }

    .article-modal-pane--comments {
        flex: 0 0 auto;
        max-width: none;
        width: 100%;
        max-height: 42vh;
        border-right: none;
        border-bottom: none;
    }

    .article-modal-pane--comments::after {
        top: auto;
        bottom: 0;
        left: 0;
        right: 0;
        width: auto;
        height: 1px;
        background: var(--divider-h-gradient);
    }

    .article-modal-pane--article {
        flex: 1 1 auto;
        min-height: 200px;
        max-height: none;
    }
}

/* 文章详情关闭按钮：贴到封面右上角 + 毛玻璃 */
#articleModal .modal-header {
    position: absolute;
    top: 12px;
    right: 12px;
    left: auto;
    z-index: 30;
    padding: 0;
    border-bottom: none !important;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: none;
    border-radius: 0;
    margin: 0;
    width: auto;
    justify-content: flex-end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
}

#articleModal .modal-close {
    background: none;
    border: none;
    color: var(--text-primary);
    padding: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(12, 14, 19, 0.25);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
}

#articleModal .modal-close:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 0 2px rgba(255, 107, 107, 0.55);
    transform: translateY(-1px);
}

#articleModal .modal-close:active {
    transform: translateY(0);
}

/* 文章详情：关闭按钮下方的小按钮组 */
#articleModal .article-header-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
}

#articleModal .article-header-action-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(12, 14, 19, 0.25);
    color: var(--text-primary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    padding: 0;
    position: relative;
}

#articleModal #articleHeaderLikeBtn {
    /* 给“点赞数字”留出下方空间，避免与举报按钮重叠 */
    margin-bottom: 14px;
}

#articleModal .article-header-action-btn:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 107, 107, 0.55);
}

#articleModal .article-header-like-count {
    position: absolute;
    top: 44px;
    left: 50%;
    transform: translateX(-50%);
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0;
    border-radius: 0;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
}

/* 隐藏弹窗内原本的大号点赞/举报，避免重复 */
#articleModal .article-actions {
    display: none;
}

/* 举报弹窗（文章详情） */
.article-report-overlay {
    position: fixed;
    inset: 0;
    z-index: 3000;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
}

.article-report-dialog {
    width: min(720px, 95vw);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 0 25px 60px var(--shadow-hover);
    overflow: hidden;
}

.article-report-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-color);
    background: rgba(12, 14, 19, 0.55);
}

.article-report-title {
    font-weight: 800;
    color: var(--text-primary);
}

.article-report-close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(12, 14, 19, 0.25);
    color: var(--text-primary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.article-report-close:hover {
    background: rgba(255, 255, 255, 0.06);
}

.article-report-body {
    padding: 16px;
}

.article-report-field {
    margin-bottom: 14px;
}

.article-report-label {
    color: var(--text-secondary);
    font-weight: 600;
    margin-bottom: 8px;
    font-size: 0.95rem;
}

.article-report-select {
    width: 100%;
    padding: 11px 12px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    outline: none;
}

.article-report-textarea {
    width: 100%;
    padding: 11px 12px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    outline: none;
    resize: vertical;
    line-height: 1.6;
}

.article-report-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 16px;
    border-top: 1px solid var(--border-color);
}

.modal-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    max-width: 90vw;
    max-height: 90vh;
    overflow-y: auto;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
}

.modal-large {
    width: 800px;
}

/* 角色教程：更宽、更深黑、顶部不显示角色大字（名称在卡片内） */
.character-tutorial-modal .character-tutorial-modal-content {
    width: min(1320px, 98vw);
    background: #060708;
    border-color: #1a1f28;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: min(820px, 92vh);
    max-height: 92vh;
}

.character-tutorial-modal .modal-header h3 {
    display: none;
}

/* 与资讯弹窗一致：关闭按钮浮在内容区右上角，去掉顶栏占高 */
#characterModal .modal-header {
    position: absolute;
    top: 12px;
    right: 12px;
    left: auto;
    z-index: 30;
    padding: 0;
    border-bottom: none !important;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: none;
    border-radius: 0;
    margin: 0;
    width: auto;
    justify-content: flex-end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
}

#characterModal .modal-close {
    background: none;
    border: none;
    color: var(--text-primary);
    padding: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(12, 14, 19, 0.25);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
}

#characterModal .modal-close:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 0 2px rgba(255, 107, 107, 0.55);
    transform: translateY(-1px);
}

#characterModal .modal-close:active {
    transform: translateY(0);
}

.character-tutorial-modal .modal-body {
    background: #060708;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    padding: 14px 20px 24px;
}

.character-tutorial-modal .modal-body > .character-detail.character-detail--tutorial-dark {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

.character-tutorial-modal .modal-body .character-tutorial-layout {
    flex: 1;
    min-height: 0;
    grid-template-rows: minmax(0, 1fr);
}

/* 教程弹窗：左右栏抻满 modal-body，避免相对 92vh 弹窗仍用 76vh 上限导致底部大块留白 */
#characterModal .character-tutorial-pane {
    max-height: none;
    height: 100%;
    min-height: 0;
}

@media screen and (max-width: 960px) {
    #characterModal .character-tutorial-layout {
        grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    }
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 30px;
    border-bottom: 1px solid var(--border-color);
}

.modal-header h3 {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--text-primary);
}

.modal-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.modal-close:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
}

.modal-body {
    padding: 30px;
}

.combo-video-player-wrap {
    width: 100%;
}

.combo-video-player {
    width: 100%;
    max-height: min(76vh, 760px);
    border-radius: 12px;
    background: #000;
}

/* 角色详情样式 */
.character-detail {
    color: var(--text-primary);
}

.character-hero {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-bottom: 40px;
    padding: 30px;
    background: var(--bg-tertiary);
    border-radius: 16px;
}

.character-detail-avatar-container {
    position: relative;
    width: 150px;
    height: 150px;
}

.character-detail-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--accent-primary);
}

.character-detail-avatar-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    border-radius: 50%;
    border: 4px solid var(--accent-primary);
    font-size: 3rem;
}

.character-info h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
}

.character-alias {
    font-size: 1.2rem;
    color: var(--accent-primary);
    font-weight: 500;
}

.character-section {
    margin-bottom: 40px;
}

.character-section h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--accent-primary);
}

.character-section p {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 1.1rem;
}

.moves-list {
    display: grid;
    gap: 16px;
}

.move-item {
    background: var(--bg-tertiary);
    padding: 20px;
    border-radius: 12px;
    border-left: 4px solid var(--accent-primary);
}

.move-name {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
}

.move-desc {
    color: var(--text-secondary);
    line-height: 1.6;
}

/* 加载指示器 */
.loading-indicator {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(4, 4, 8, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 3000;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    color: var(--text-primary);
}

.spinner {
    width: 44px;
    height: 44px;
    border: 3px solid rgba(255, 255, 255, 0.08);
    border-top-color: var(--accent-primary);
    border-radius: 50%;
    animation: spin 0.85s linear infinite;
    margin-bottom: 18px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* 响应式设计 */
@media (max-width: 768px) {
    html.tfhers-authed {
        --nav-height: calc(var(--mobile-topbar-height) + var(--app-topbar-height));
        --sidebar-width: 0px;
    }

    /* On mobile always use floating/topbar toggle; sidebar is overlay drawer */
    html.tfhers-authed .sidebar-float-cluster,
    html.tfhers-authed .sidebar-float-toggle {
        display: none !important;
    }

    .mobile-topbar {
        display: flex;
        align-items: center;
        gap: 10px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--mobile-topbar-height);
        padding: 0 12px;
        z-index: 1001;
        background: rgba(14, 14, 18, 0.92);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
    }

    .mobile-topbar-spacer {
        flex: 1;
    }

    /* App topbar sits under mobile brand bar */
    html.tfhers-authed .app-topbar {
        top: var(--mobile-topbar-height);
        left: 0;
        right: 0;
        padding-left: 0;
        z-index: 1002;
        height: var(--app-topbar-height);
    }

    html.tfhers-authed.sidebar-collapsed .app-topbar {
        padding-left: 0;
    }

    .app-topbar-inner {
        padding: 0 10px;
        gap: 8px;
    }


    html.tfhers-authed .app-top-actions {
        gap: 4px;
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }

    .top-post-btn {
        height: 34px;
        padding: 0 10px;
        font-size: 12px;
    }

    .top-post-btn .fa-pen {
        display: none;
    }

    .top-icon-btn,
    .top-avatar-btn {
        width: 34px;
        height: 34px;
    }

    .top-post-menu {
        left: auto;
        right: 0;
        transform-origin: top right;
    }

    .app-sidebar {
        width: min(280px, 86vw);
        transform: translateX(-105%);
        visibility: visible;
        pointer-events: auto;
        transition: transform 0.28s var(--ease-out);
        z-index: 1100;
    }

    /* Ignore desktop collapsed transform on mobile; use sidebar-open instead */
    html.tfhers-authed.sidebar-collapsed .app-sidebar {
        transform: translateX(-105%);
        visibility: visible;
        pointer-events: auto;
    }

    html.tfhers-authed.sidebar-open .app-sidebar {
        transform: translateX(0);
        visibility: visible;
        pointer-events: auto;
    }

    html.tfhers-authed.sidebar-open .sidebar-backdrop {
        display: block;
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(0, 0, 0, 0.55);
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
    }

    .main-content {
        margin-left: 0;
        margin-top: var(--nav-height);
        min-height: calc(100vh - var(--nav-height));
        min-height: calc(100dvh - var(--nav-height));
    }

    .page-title {
        font-size: 2.5rem;
    }

    .page-subtitle {
        font-size: 1rem;
    }

    .articles-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .characters-grid {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .character-hero {
        flex-direction: column;
        text-align: center;
    }

    .character-detail-avatar {
        width: 120px;
        height: 120px;
    }

    .modal-content {
        width: 95vw;
        margin: 20px;
    }

    .modal-large {
        width: 95vw;
    }
}

@media (max-width: 480px) {
    .main-content {
        padding: 20px 0;
    }

    .page {
        padding: 0 15px;
    }

    .page-title {
        font-size: 2rem;
    }

    .character-card {
        padding: 20px;
    }

    .character-avatar {
        width: 100px;
        height: 100px;
    }

    .tutorial-card {
        padding: 30px 20px;
    }
    
    /* 我的页面响应式 */
    .profile-card {
        flex-direction: column;
        text-align: center;
        gap: 16px;
    }
    
    .action-grid {
        grid-template-columns: 1fr;
    }
    
    .login-card {
        margin: 0 20px;
        padding: 30px 20px;
    }
}

/* 滚动条样式 */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: var(--bg-secondary);
}

::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
}

/* 登录按钮组 */
.login-buttons {
    display: flex;
    gap: 12px;
    margin-top: 20px;
}

.login-buttons .btn {
    flex: 1;
}

/* 模态框底部 */
.modal-footer {
    text-align: center;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
}

.modal-footer a {
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 500;
}

.modal-footer a:hover {
    text-decoration: underline;
}

/* 表单样式 */
.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    color: var(--text-primary);
    font-weight: 500;
}

.form-group input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 1rem;
    transition: border-color 0.3s ease;
}

.form-group input:focus {
    outline: none;
    border-color: var(--accent-primary);
}

/* 头像预览 */
.avatar-preview {
    margin-top: 10px;
    text-align: center;
}

.avatar-preview img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-color);
}

/* 全宽按钮 */
.btn-full {
    width: 100%;
    justify-content: center;
}

/* 我的页面样式 */
.login-section {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - var(--nav-height));
    padding: 48px 20px;
    width: 100%;
}

.login-card {
    background: var(--bg-secondary);
    border-radius: 20px;
    padding: 40px;
    text-align: center;
    border: 1px solid var(--border-color);
    max-width: 400px;
    width: 100%;
}

.login-card--quote {
    /* 不使用毛玻璃/卡片：直接叠在背景图上 */
    background: transparent;
    border: none;
    box-shadow: none;
    border-radius: 0;
    padding: 0;
    max-width: min(860px, 92vw);
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* 让“整体居中”，按钮也移动到页面中间 */
    min-height: min(520px, 54vh);
    justify-content: center;
    gap: 22px;
}

.login-quote {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0;
}

.login-quote-text {
    font-size: clamp(2.1rem, 6vw, 3.15rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 14px;
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.78);
}

.login-quote-meta {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.62);
    letter-spacing: 0.02em;
    margin-bottom: 18px;
    text-shadow: 0 8px 20px rgba(0, 0, 0, 0.72);
}

.login-buttons--glass {
    margin-top: 0;
    justify-content: center;
    flex-wrap: nowrap;
    width: 100%;
    display: flex;
    align-items: center;
    margin-bottom: 0;
}

.login-buttons--glass .btn {
    flex: 0 0 auto;
    min-width: 132px;
}

.btn-glass {
    background: transparent;
    color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
    font-size: 1.05rem;
    padding: 12px 22px;
}

.btn-glass:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 107, 107, 0.55);
    color: var(--text-primary);
}

.btn-glass:active {
    transform: translateY(0);
}

.login-icon {
    font-size: 4rem;
    color: var(--accent-primary);
    margin-bottom: 20px;
}

.login-title {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
}

.login-subtitle {
    color: var(--text-secondary);
    margin-bottom: 30px;
    font-size: 1rem;
}

.user-section {
    max-width: 1180px;
    margin: 0 auto;
}

.my-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 22px;
}

.my-left-column,
.my-right-column {
    min-width: 0;
}

.my-right-column {
    border-left: 1px solid var(--border-color);
    padding-left: 22px;
}

.profile-card {
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 36px;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: box-shadow 0.35s var(--ease-out), border-color 0.35s var(--ease-out);
}

.profile-card:hover {
    box-shadow: var(--shadow-md);
    border-color: rgba(255, 255, 255, 0.14);
}

.profile-card-main {
    margin-bottom: 18px;
}

.profile-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--accent-primary);
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-info {
    flex: 1;
}

.profile-name {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
}

.profile-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
}

.profile-signature {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
}

.profile-settings-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.profile-settings-btn:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
}

.profile-top-actions {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.profile-logout-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.profile-logout-btn:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
}

.action-section, .settings-section {
    margin-bottom: 40px;
}

.action-section {
    margin-bottom: 0;
}

.action-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.action-card {
    background: var(--bg-secondary);
    border-radius: 16px;
    padding: 24px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid var(--border-color);
}

.action-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px var(--shadow);
    border-color: var(--accent-primary);
}

.action-icon {
    font-size: 2.5rem;
    color: var(--accent-primary);
    margin-bottom: 16px;
}

.action-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
}

.action-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
}

.settings-list {
    margin-top: 20px;
}

.setting-item {
    background: var(--bg-secondary);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid var(--border-color);
    margin-bottom: 12px;
}

.setting-item:hover {
    background: var(--bg-tertiary);
    border-color: var(--accent-primary);
}

.setting-item i:first-child {
    font-size: 1.2rem;
    color: var(--accent-primary);
    width: 20px;
}

.setting-item span {
    flex: 1;
    color: var(--text-primary);
    font-weight: 500;
}

.setting-item i:last-child {
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* 空状态样式 */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary);
}

.empty-icon {
    font-size: 4rem;
    color: var(--text-muted);
    margin-bottom: 20px;
}

.empty-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
}

.empty-desc {
    font-size: 1rem;
    line-height: 1.5;
    max-width: 400px;
    margin: 0 auto;
}

/* 文章详情：封面 + 毛玻璃作者栏 */
.article-detail-cover-wrap {
    position: relative;
    width: 100%;
    min-height: min(36vh, 280px);
    background: #0c0e13;
    border-radius: 12px;
    overflow: hidden;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* 模糊铺底，横/竖图都有好看的 letterbox */
.article-detail-cover-bg {
    position: absolute;
    inset: -12px;
    background-size: cover;
    background-position: center;
    filter: blur(28px) saturate(1.15);
    transform: scale(1.08);
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
}

.article-detail-cover-img {
    position: relative;
    z-index: 1;
    width: 100%;
    max-height: min(52vh, 480px);
    height: auto;
    min-height: min(28vh, 220px);
    object-fit: contain;
    display: block;
    object-position: center;
    background: transparent;
}

.article-detail-glassbar {
    position: absolute;
    z-index: 2;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(12, 14, 19, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.article-detail-author {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
}

.article-detail-author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(0, 0, 0, 0.2);
}

.article-detail-author-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.article-detail-author-name {
    color: #d4d8e0;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.article-detail-time {
    color: rgba(180, 188, 200, 0.9);
    font-size: 0.78rem;
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}

.article-detail-time i {
    opacity: 0.85;
}

.article-detail-title-wrap {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    min-width: 0;
}

.article-detail-title-right {
    margin: 0;
    color: var(--text-primary);
    font-weight: 800;
    font-size: 1.1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.article-detail-summary {
    margin-top: 18px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
}

.article-detail-content {
    margin-top: 12px;
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.85;
}

.article-detail-content p {
    margin: 0 0 14px;
}

/* 正文内图片/视频：约为此前一半显示尺寸；外框 + 内留白，与暗色主题统一 */
.article-detail-content img,
.article-detail-content video,
.article-detail-content picture > img {
    max-width: 50%;
    width: auto;
    height: auto;
    max-height: min(36vh, 340px);
    min-width: min(100%, 60px);
    object-fit: contain;
    object-position: center;
    display: block;
    margin: 14px auto;
    padding: 6px;
    border-radius: var(--radius-md);
    box-sizing: border-box;
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    box-shadow:
        0 10px 32px var(--shadow),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.article-detail-content figure {
    margin: 16px 0;
    max-width: 100%;
}

.article-detail-content figure img {
    margin-left: auto;
    margin-right: auto;
}

.article-detail-content figcaption {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 8px;
    line-height: 1.5;
    text-align: center;
}

/* 正文内连续多图：12 列网格 + dense 填充，跨度由 JS 按文章 id 伪随机分配 */
.article-image-masonry {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(88px, auto);
    grid-auto-flow: dense;
    gap: 10px;
    margin: 18px 0;
    width: 100%;
    align-items: stretch;
}

.article-image-masonry > * {
    min-width: 0;
    min-height: 0;
    align-self: stretch;
}

.article-image-masonry > img,
.article-image-masonry > video {
    width: 100%;
    height: 100%;
    min-height: 96px;
    max-height: min(34vh, 280px);
    max-width: none !important;
    margin: 0 !important;
    object-fit: cover;
    object-position: center;
    padding: 5px;
    border-radius: var(--radius-md);
    box-sizing: border-box;
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    box-shadow:
        0 8px 24px var(--shadow),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.article-image-masonry > figure {
    display: flex;
    flex-direction: column;
    margin: 0 !important;
    max-width: none !important;
    padding: 5px;
    border-radius: var(--radius-md);
    box-sizing: border-box;
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    box-shadow:
        0 8px 24px var(--shadow),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.article-image-masonry > figure img,
.article-image-masonry > figure video {
    width: 100%;
    flex: 1 1 auto;
    min-height: 80px;
    max-height: min(30vh, 240px);
    max-width: none !important;
    margin: 0 !important;
    object-fit: cover;
    border-radius: calc(var(--radius-md) - 4px);
    padding: 0;
    border: none;
    box-shadow: none;
    background: transparent;
}

.article-image-masonry > figure figcaption {
    margin-top: 6px;
    padding: 0 2px;
}

/* 文章评论编辑器（自动增高 + 底部操作） */
.article-comment-editor {
    position: relative;
    margin-top: 12px;
}

.article-comment-textarea {
    width: 100%;
    padding: 12px 12px 56px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    line-height: 1.6;
    font-size: 0.95rem;
    resize: none;
    min-height: 54px;
    max-height: 220px;
    overflow-y: auto;
}

.article-comment-actions {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.article-comment-image-input {
    display: none;
}

.article-comment-image-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
}

.article-comment-image-btn:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
}

.article-comment-submit-btn {
    padding: 8px 14px;
    border-radius: 10px;
}

/* 文章详情：点赞与评论 */
.article-actions {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
}

.article-like-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 20px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.95rem;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
}

.article-like-btn:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
}

.article-like-btn.liked {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
}

.article-like-btn.liked i {
    color: var(--accent-primary);
}

.article-comments-section {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
}

/* 资讯弹窗左侧评论栏：须在通用 .article-comments-section 之后写，否则 border-top 会被覆盖 */
.article-comments-section.article-comments-section--pane {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
}

.comments-title {
    font-size: 1.1rem;
    margin-bottom: 16px;
    color: var(--text-primary);
}

.comment-list {
    margin-top: 16px;
}

.comment-empty {
    color: var(--text-muted);
    font-size: 0.9rem;
    padding: 16px 0;
}

.comment-item {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
    align-items: flex-start;
}

.comment-avatar-wrap {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--bg-tertiary);
}

.comment-avatar-wrap .comment-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.comment-body {
    flex: 1;
    min-width: 0;
}

.comment-author {
    font-weight: 600;
    color: var(--text-primary);
    margin-right: 8px;
}

.comment-time {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.comment-content {
    margin: 8px 0 4px;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
}

.comment-content .comment-image {
    width: 100%;
    max-width: 520px;
    border-radius: 12px;
    margin-top: 10px;
    display: block;
}

.comment-replies {
    margin-top: 12px;
    padding: 10px 12px 6px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
}

.comment-replies .comment-item {
    margin-bottom: 12px;
}

.comment-replies-more {
    display: none;
}

.comment-replies.is-expanded .comment-replies-more {
    display: block;
}

.comment-expand-replies {
    display: inline-block;
    margin: 4px 0 10px;
    font-size: 0.88rem;
    color: var(--accent-tertiary);
}

.comment-avatar-wrap--sm {
    width: 28px;
    height: 28px;
}

.comment-reply-to {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-right: 8px;
}

.comment-reply-to-name {
    color: var(--accent-tertiary);
    font-weight: 600;
}

.article-comment-reply-hint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 0 0 8px;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    font-size: 0.88rem;
}

.article-comment-reply-hint .reply-hint-name {
    color: var(--accent-tertiary);
    font-weight: 600;
}

.comment-item--reply .comment-content {
    margin-top: 4px;
}

.link-btn {
    background: none;
    border: none;
    color: var(--accent-tertiary);
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0;
}

.link-btn:hover {
    text-decoration: underline;
}

/* Steam 绑定卡片（用户主页） */
.steam-box {
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    border-radius: 14px;
    padding: 14px 14px 12px;
    box-shadow: 0 10px 30px var(--shadow);
    margin-bottom: 18px;
}

.steam-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.steam-box-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.steam-box-title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font-weight: 700;
}

.steam-box-title i {
    color: var(--accent-tertiary);
}

.steam-refresh-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, border-color 0.2s, transform 0.05s;
}

.steam-refresh-btn:hover {
    color: var(--accent-secondary);
    border-color: var(--accent-secondary);
}

.steam-refresh-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.steam-icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, border-color 0.2s, transform 0.05s;
}

.steam-icon-btn:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
}

.steam-icon-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.steam-box-body .profile-steam-info img.steam-avatar {
    border: 1px solid var(--border-color);
}

.profile-steam-info .steam-profile-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

.profile-steam-info .steam-avatar-large {
    width: 44px;
    height: 44px;
    border-radius: 4px;
    object-fit: cover;
    border: 1px solid var(--border-color);
    flex-shrink: 0;
}

.profile-steam-info .steam-profile-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: var(--text-secondary);
    font-size: 0.92rem;
}

.steam-sync-hint {
    margin-top: 10px;
    font-size: 0.82rem;
    line-height: 1.45;
}

.steam-sync-hint--err {
    color: var(--text-muted);
}

.my-stats-card {
    background: var(--bg-secondary);
    border-radius: 20px;
    border: 1px solid var(--border-color);
    padding: 22px;
    position: static;
}

.my-stats-grid {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.my-stat-item {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 14px 12px;
}

.my-stat-label {
    display: block;
    color: var(--text-muted);
    font-size: 0.86rem;
    margin-bottom: 6px;
}

.my-stat-value {
    color: var(--text-primary);
    font-size: 1.15rem;
    font-weight: 700;
}

@media screen and (max-width: 980px) {
    .my-layout {
        grid-template-columns: 1fr;
    }

    .my-right-column {
        border-left: none;
        padding-left: 0;
        border-top: 1px solid var(--border-color);
        padding-top: 18px;
    }
}

.steam-achievements {
    border-top: 1px solid var(--border-color);
    padding-top: 10px;
}

.steam-achievements .achv-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 8px;
}

.steam-achievements .achv-toggle {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.88rem;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.steam-achievements .achv-toggle:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--text-primary);
}

.steam-achievements .achv-toggle:active {
    transform: translateY(0);
}

.steam-achievements .achv-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
}

.steam-achievements .achv-item {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    border-radius: 10px;
    padding: 8px;
    min-width: 0;
}

.steam-achievements .achv-item--locked {
    opacity: 0.66;
}

.steam-achievements .achv-item--locked .achv-icon {
    filter: grayscale(1);
}

.steam-achievements .achv-item--locked .achv-name {
    color: var(--text-secondary);
}

.steam-achievements .achv-grid--all {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

@media screen and (max-width: 980px) {
    .steam-achievements .achv-grid--all {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media screen and (max-width: 560px) {
    .steam-achievements .achv-grid--all {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

.steam-achievements .achv-icon {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
    background: #000;
}

.steam-achievements .achv-name {
    color: var(--text-primary);
    font-size: 0.9rem;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.steam-achievements .achv-empty {
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* 玩家连段：发布者头像、页内播放与下载 */
.user-combo-list .user-combo-item {
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
}

.user-combo-list .user-combo-item:last-child {
    border-bottom: none;
}

.user-combo-author {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
}

.user-combo-avatar-wrap {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--bg-tertiary);
}

.user-combo-avatar-wrap .user-combo-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.user-combo-author-name {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.user-combo-file-wrap {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

.user-combo-file-wrap .user-combo-download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.user-combo-video-wrap {
    margin-top: 12px;
}

.user-combo-video-wrap .user-combo-video {
    width: 100%;
    max-width: 560px;
    max-height: 320px;
    border-radius: 8px;
    background: #000;
}

/* 空状态块入场 */
@media (prefers-reduced-motion: no-preference) {
    .empty-state {
        animation: tfhers-empty-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
}

@keyframes tfhers-empty-in {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

html {
    scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }
}

:focus-visible {
    outline: 2px solid var(--accent-secondary);
    outline-offset: 3px;
}

button:focus:not(:focus-visible) {
    outline: none;
}

/* 选择文本样式 */
::selection {
    background: rgba(255, 122, 122, 0.35);
    color: var(--text-primary);
}

::-moz-selection {
    background: rgba(255, 122, 122, 0.35);
    color: var(--text-primary);
}


/* ===== 个人设置弹窗 ===== */
.profile-settings-modal-content {
    width: min(520px, 94vw);
}

.settings-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 22px;
    padding: 4px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-color);
}

.settings-tab-btn {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    padding: 10px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 500;
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
}

.settings-tab-btn:hover {
    color: var(--text-primary);
}

.settings-tab-btn.active {
    background: var(--bg-elevated);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
}

.settings-tab-panel {
    display: none;
}

.settings-tab-panel.active {
    display: block;
}

.form-hint {
    display: block;
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 0.8rem;
}

.form-group textarea {
    width: 100%;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.5;
    resize: vertical;
    min-height: 80px;
}

.form-group textarea:focus {
    outline: none;
    border-color: var(--accent-primary);
}

.form-group input:disabled {
    opacity: 0.65;
    cursor: not-allowed;
}

.settings-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 8px;
    padding-top: 8px;
}

.settings-avatar-current {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
}

.settings-avatar-current img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-strong);
    background: var(--bg-tertiary);
}

.app-toast {
    position: fixed;
    left: 50%;
    bottom: 36px;
    transform: translateX(-50%) translateY(20px);
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 12px 18px;
    box-shadow: var(--shadow-md);
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out);
    max-width: min(90vw, 420px);
    text-align: center;
    font-size: 0.95rem;
}

.app-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

.app-toast.success {
    border-color: rgba(95, 217, 204, 0.45);
}

.app-toast.error {
    border-color: rgba(255, 122, 122, 0.55);
}

@media screen and (max-width: 640px) {
    .settings-tabs {
        flex-direction: column;
        border-radius: var(--radius-md);
    }
    .settings-tab-btn {
        border-radius: var(--radius-sm);
    }
    .settings-form-actions {
        flex-direction: column-reverse;
    }
    .settings-form-actions .btn {
        width: 100%;
    }
}


/* ===== 头像裁剪（Steam 风格） ===== */
.avatar-crop-modal {
    z-index: 2100;
}

.avatar-crop-modal-content {
    width: min(440px, 94vw);
    overflow: hidden;
}

.avatar-crop-body {
    padding-top: 4px;
}

.avatar-crop-hint {
    margin: 0 0 14px;
    color: var(--text-muted);
    font-size: 0.85rem;
    text-align: center;
}

.avatar-crop-stage {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
    user-select: none;
    -webkit-user-select: none;
}

.avatar-crop-viewport {
    position: relative;
    width: 280px;
    height: 280px;
    overflow: hidden;
    border-radius: 4px;
    background: #0a0a10;
    cursor: grab;
    touch-action: none;
    box-shadow: inset 0 0 0 1px var(--border-color);
}

.avatar-crop-viewport.is-dragging {
    cursor: grabbing;
}

.avatar-crop-viewport img {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    max-height: none;
    transform-origin: 0 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
}

.avatar-crop-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: 0 0 0 9999px rgba(4, 4, 8, 0.62);
    border: 2px solid rgba(255, 255, 255, 0.88);
    border-radius: 2px;
    z-index: 2;
}

.avatar-crop-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(to right, rgba(255,255,255,0.18) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,255,255,0.18) 1px, transparent 1px);
    background-size: 33.333% 33.333%;
    opacity: 0.55;
}

.avatar-crop-preview-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 14px;
}

.avatar-crop-preview-label {
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.avatar-crop-preview-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border-strong);
    background: var(--bg-tertiary);
    flex-shrink: 0;
}

.avatar-crop-preview-circle canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.avatar-crop-zoom-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--text-muted);
}

.avatar-crop-zoom-row input[type="range"] {
    flex: 1;
    accent-color: var(--accent-primary);
    height: 4px;
    cursor: pointer;
}

.avatar-crop-actions {
    margin-top: 12px;
}

@media screen and (max-width: 640px) {
    .avatar-crop-viewport {
        width: min(280px, 78vw);
        height: min(280px, 78vw);
    }
}



/* ===== 封面裁切（宽屏 3:1） ===== */
.cover-crop-modal {
    z-index: 2100;
}

.cover-crop-modal-content {
    width: min(560px, 96vw);
    overflow: hidden;
}

.cover-crop-body {
    padding-top: 4px;
}

.cover-crop-hint {
    margin: 0 0 14px;
    color: var(--text-muted);
    font-size: 0.85rem;
    text-align: center;
}

.cover-crop-stage {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
    user-select: none;
    -webkit-user-select: none;
}

.cover-crop-viewport {
    position: relative;
    width: min(480px, 88vw);
    height: calc(min(480px, 88vw) / 3);
    overflow: hidden;
    border-radius: 6px;
    background: #0a0a10;
    cursor: grab;
    touch-action: none;
    box-shadow: inset 0 0 0 1px var(--border-color);
}

.cover-crop-viewport.is-dragging {
    cursor: grabbing;
}

.cover-crop-viewport img {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    max-height: none;
    transform-origin: 0 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
}

.cover-crop-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: 0 0 0 9999px rgba(4, 4, 8, 0.62);
    border: 2px solid rgba(255, 255, 255, 0.88);
    border-radius: 2px;
    z-index: 2;
}

.cover-crop-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(to right, rgba(255,255,255,0.16) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,255,255,0.16) 1px, transparent 1px);
    background-size: 33.333% 50%;
    opacity: 0.5;
}

.cover-crop-preview-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 14px;
}

.cover-crop-preview-label {
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.cover-crop-preview-rect {
    width: 180px;
    height: 60px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid var(--border-strong, var(--border-color));
    background: var(--bg-tertiary);
    flex-shrink: 0;
}

.cover-crop-preview-rect canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.cover-crop-zoom-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--text-muted);
}

.cover-crop-zoom-row input[type="range"] {
    flex: 1;
    accent-color: var(--accent-primary);
    height: 4px;
    cursor: pointer;
}

.cover-crop-actions {
    margin-top: 12px;
}


/* 我的：资讯 / 连段管理列表 */
.my-content-card {
    margin-top: 18px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl, 14px);
    padding: 16px 18px 12px;
}
.my-content-card .section-title {
    margin: 0 0 12px;
}
.my-content-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 320px;
    overflow-y: auto;
}
.my-content-empty {
    color: var(--text-muted, #888);
    font-size: 0.9rem;
    padding: 12px 4px;
}
.my-content-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
}
.my-content-item-main {
    flex: 1;
    min-width: 0;
}
.my-content-item-title {
    font-weight: 600;
    color: var(--text-primary, #fff);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.95rem;
}
.my-content-item-meta {
    margin-top: 2px;
    font-size: 0.78rem;
    color: var(--text-secondary, #999);
}
.my-content-item-actions {
    display: flex;
    flex-shrink: 0;
    gap: 6px;
}
.my-content-item-actions .btn {
    padding: 4px 10px;
    font-size: 0.78rem;
}
.my-content-status {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    margin-left: 6px;
}
.my-content-status.pending { background: rgba(241,196,15,0.2); color: #ffe08a; }
.my-content-status.approved { background: rgba(46,204,113,0.2); color: #7dffa8; }
.my-content-status.rejected { background: rgba(231,76,60,0.2); color: #ffb4ab; }

/* 段位 / 站内名次 / 胜负：靠左贴近用户名 */
.profile-info .profile-rating-badge {
    justify-content: flex-start;
    text-align: left;
}
.profile-card-main .profile-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}


/* ===== 个人设置：内容管理 ===== */
.profile-settings-modal-content.settings-wide {
    width: min(640px, 96vw);
}

.settings-tabs {
    flex-wrap: wrap;
}

.settings-content-hint {
    margin: 0 0 14px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.45;
}

.settings-content-section + .settings-content-section {
    margin-top: 18px;
}

.settings-content-title {
    margin: 0 0 10px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
}

.settings-my-content-list {
    max-height: 220px;
    overflow-y: auto;
    padding-right: 4px;
}

/* ===== 通用确认弹窗 ===== */
.app-confirm-modal {
    z-index: 4200;
}

.app-confirm-modal-content {
    width: min(400px, 92vw);
    padding-bottom: 16px;
}

.app-confirm-body {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding-top: 4px;
}

.app-confirm-icon {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    background: rgba(255, 107, 107, 0.14);
    border: 1px solid rgba(255, 107, 107, 0.32);
    color: var(--accent-primary);
}

.app-confirm-message {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
    padding-top: 8px;
}

.app-confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 18px;
    padding: 0 4px;
}

.app-confirm-ok.btn-secondary {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #fff;
}


/* ========== 未登录入口页（pixiv 风格） ========== */
html:not(.tfhers-authed) .app-sidebar,
html:not(.tfhers-authed) .mobile-topbar,
html:not(.tfhers-authed) .app-topbar,
html:not(.tfhers-authed) .sidebar-float-toggle,
html:not(.tfhers-authed) .sidebar-float-cluster,
html:not(.tfhers-authed) .sidebar-backdrop,
html:not(.tfhers-authed) .main-content,
html:not(.tfhers-authed) #roomsLoginGate,
html:not(.tfhers-authed) #aiChatLoginGate {
    display: none !important;
}

html:not(.tfhers-authed) #authEntryOverlay {
    display: flex;
}

html.tfhers-authed #authEntryOverlay {
    display: none !important;
}

.auth-entry {
    position: fixed;
    inset: 0;
    z-index: 1400; /* 低于 .modal(2000)，登录/注册弹窗可盖在入口页上 */
    display: none;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    background: transparent;
    pointer-events: auto;
}

.auth-entry-top {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    padding: 18px 22px 8px;
}

.auth-entry-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.auth-entry-logo {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
}

.auth-entry-brand-text {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
}

.auth-entry-center {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px 24px;
}

.auth-entry-card {
    width: min(380px, 92vw);
    background: rgba(17, 17, 22, 0.88);
    color: var(--text-primary);
    border-radius: 28px;
    padding: 36px 32px 32px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    text-align: center;
}

.auth-entry-card-title {
    margin: 0 0 26px;
    font-size: 1.35rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.96);
    letter-spacing: 0.02em;
}

.auth-entry-card-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
}

.auth-entry-btn {
    appearance: none;
    border: none;
    border-radius: 9999px;
    padding: 13px 18px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    transition: transform 0.18s var(--ease-out), filter 0.18s var(--ease-out), background 0.18s var(--ease-out), border-color 0.18s var(--ease-out);
    font-family: inherit;
}

.auth-entry-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
}

.auth-entry-btn:active {
    transform: translateY(0);
}

.auth-entry-btn--primary {
    background: linear-gradient(135deg, var(--accent-primary), #ff9292);
    color: #0c0c10;
    box-shadow: 0 10px 24px rgba(255, 122, 122, 0.28);
}

.auth-entry-btn--secondary {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.14);
}

.auth-entry-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 122, 122, 0.45);
}

.auth-entry-footer {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 16px 6px;
    min-height: 32px;
    background: rgba(10, 10, 14, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.auth-entry-about {
    position: relative;
    display: inline-flex;
    align-items: center;
}

.auth-entry-footer-link {
    appearance: none;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: default;
    padding: 2px 4px;
    font-family: inherit;
}

.auth-entry-about:hover .auth-entry-footer-link,
.auth-entry-about:focus-within .auth-entry-footer-link {
    color: #fff;
}

.auth-entry-about-tip {
    position: absolute;
    left: 0;
    bottom: calc(100% + 10px);
    min-width: max-content;
    max-width: min(320px, 80vw);
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(26, 26, 32, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.45;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s ease;
    pointer-events: none;
    z-index: 5;
}

.auth-entry-about-tip::after {
    content: '';
    position: absolute;
    left: 16px;
    top: 100%;
    border: 6px solid transparent;
    border-top-color: rgba(26, 26, 32, 0.96);
}

.auth-entry-about:hover .auth-entry-about-tip,
.auth-entry-about:focus-within .auth-entry-about-tip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

@media screen and (max-width: 520px) {
    .auth-entry-card {
        padding: 28px 22px 24px;
        border-radius: 22px;
    }
    .auth-entry-card-title {
        font-size: 1.2rem;
    }
    .auth-entry-about-tip {
        white-space: normal;
    }
}

.auth-entry-step {
    display: none;
    width: 100%;
}
.auth-entry-step.is-active {
    display: block;
}
.auth-entry-card-title--form {
    margin-bottom: 18px;
    font-size: 1.25rem;
}
.auth-entry-back {
    appearance: none;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0 0 14px;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.auth-entry-back:hover {
    color: #fff;
}
.auth-entry-form {
    text-align: left;
}
.auth-entry-form .form-group {
    margin-bottom: 14px;
}
.auth-entry-form .form-group label {
    display: block;
    margin-bottom: 6px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.88rem;
    font-weight: 600;
}
.auth-entry-form .form-group input[type="text"],
.auth-entry-form .form-group input[type="password"],
.auth-entry-form .form-group input[type="email"],
.auth-entry-form .form-group input[type="tel"],
.auth-entry-form .form-group input[type="file"] {
    width: 100%;
    box-sizing: border-box;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(8, 8, 12, 0.55);
    color: rgba(255, 255, 255, 0.94);
    padding: 11px 12px;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
}
.auth-entry-form .form-group input:focus {
    border-color: rgba(255, 122, 122, 0.55);
    box-shadow: 0 0 0 3px rgba(255, 122, 122, 0.15);
}
.auth-entry-form .auth-entry-btn {
    margin-top: 6px;
}
.auth-entry-switch {
    margin: 16px 0 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.88rem;
}
.auth-entry-switch a {
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 700;
}
.auth-entry-switch a:hover {
    text-decoration: underline;
}
.auth-entry-card {
    max-height: min(86vh, 820px);
    overflow-y: auto;
}



/* password show/hide */
.password-field { position: relative; display: flex; align-items: center; }
.password-field input { width: 100%; padding-right: 44px; }
.password-toggle { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); border: none; background: transparent; color: rgba(255,255,255,0.55); cursor: pointer; padding: 6px 8px; line-height: 1; border-radius: 8px; }
.password-toggle:hover { color: rgba(255,255,255,0.92); background: rgba(255,255,255,0.06); }
.password-toggle:focus-visible { outline: 2px solid rgba(255,122,122,0.55); outline-offset: 1px; }


.auth-entry-btn.is-loading {
    opacity: 0.85;
    cursor: wait;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}
.auth-entry-btn.is-loading .fa-spinner {
    font-size: 0.95em;
}


/* ========== Settings page ========== */
.page-settings {
    max-width: 520px;
}

.settings-page-wrap {
    padding: 8px 0 48px;
}

/* Compact left-aligned form column (not full-bleed) */
.settings-page-body .form-group input,
.settings-page-body .password-field {
    max-width: 340px;
}

.settings-page-body .settings-notify-list,
.settings-page-body .settings-bind-block,
.settings-page-body > .settings-block > .settings-toggle-row {
    max-width: 420px;
}

.settings-page-body .settings-form-actions {
    justify-content: flex-start;
    max-width: 420px;
}

.settings-page-header {
    margin-bottom: 8px;
}

.settings-page-title {
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 6px;
}

.settings-page-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
}

.settings-page-body {
    margin-top: 12px;
}

.settings-block {
    padding: 22px 0;
}

.settings-block-title {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--text-primary);
    margin: 0 0 16px;
}

.settings-divider {
    border: none;
    height: 1px;
    margin: 0;
    background: var(--divider-h-gradient);
}

.settings-subsection {
    margin-top: 22px;
    padding-top: 8px;
}

.settings-subsection-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin: 0 0 12px;
}

.settings-toggle-hint {
    margin-left: 6px;
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.85em;
}

.settings-toggle-row input[type="checkbox"] {
    width: 42px;
    height: 24px;
    appearance: none;
    -webkit-appearance: none;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    position: relative;
    cursor: pointer;
    flex-shrink: 0;
    border: 1px solid var(--border-color);
    transition: background 0.2s var(--ease-out);
}

.settings-toggle-row input[type="checkbox"]::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.2s var(--ease-out);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
}

.settings-toggle-row input[type="checkbox"]:checked {
    background: var(--accent-primary);
    border-color: transparent;
}

.settings-toggle-row input[type="checkbox"]:checked::after {
    transform: translateX(18px);
}

.settings-toggle-row input[type="checkbox"]:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}

/* Light theme overrides (黑暗模式默认；关闭后启用) */
html.theme-light,
html.theme-light body {
    color-scheme: light;
}

html.theme-light {
    --bg-primary: #f4f4f7;
    --bg-secondary: #ffffff;
    --bg-tertiary: #ececf1;
    --bg-elevated: #ffffff;
    --bg-quaternary: #e4e4ea;
    --card-surface: #ffffff;
    --card-surface-hover: #f7f7fa;
    --card-surface-inset: #f0f0f4;
    --text-primary: #18181f;
    --text-secondary: #4a4a55;
    --text-muted: #7a7a86;
    --border-color: rgba(0, 0, 0, 0.08);
    --border-strong: rgba(0, 0, 0, 0.14);
    --shadow: rgba(0, 0, 0, 0.08);
    --shadow-hover: rgba(0, 0, 0, 0.12);
    --shadow-sm: 0 2px 12px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 12px 36px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 20px 48px rgba(0, 0, 0, 0.1);
    --glow-accent: 0 0 32px rgba(255, 122, 122, 0.1);
    --divider-h-gradient: linear-gradient(
        90deg,
        transparent 0%,
        rgba(0, 0, 0, 0.06) 12%,
        rgba(255, 122, 122, 0.35) 50%,
        rgba(95, 217, 204, 0.25) 64%,
        rgba(0, 0, 0, 0.06) 88%,
        transparent 100%
    );
}

html.theme-light .app-sidebar,
html.theme-light .app-topbar,
html.theme-light .top-account-panel {
    background: var(--bg-secondary);
    border-color: var(--border-color);
}

html.theme-light .settings-toggle-row {
    background: rgba(0, 0, 0, 0.03);
}

html.theme-light .settings-toggle-row input[type="checkbox"] {
    background: rgba(0, 0, 0, 0.12);
}


/* ========== Manuscripts page ========== */
.page-manuscripts {
    max-width: 720px;
}

.manuscripts-page-wrap {
    padding: 8px 0 48px;
}

.manuscripts-tabs {
    display: inline-flex;
    gap: 4px;
    margin: 16px 0 18px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-color);
}

.manuscripts-tab {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.18s var(--ease-out), color 0.18s var(--ease-out);
}

.manuscripts-tab:hover {
    color: var(--text-primary);
}

.manuscripts-tab.is-active {
    background: var(--accent-primary);
    color: #fff;
}

.manuscripts-tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4em;
    height: 1.4em;
    padding: 0 5px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.22);
    color: inherit;
}

.manuscripts-tab:not(.is-active) .manuscripts-tab-count {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
}

.manuscripts-panels {
    margin-top: 4px;
}

.manuscripts-panel[hidden] {
    display: none !important;
}

.page-manuscripts .manuscripts-list {
    max-height: none;
    gap: 10px;
}

.page-manuscripts .my-content-item {
    padding: 12px 14px;
}




/* ===== 数据页：Steam 资料（重排） ===== */
.page-data .data-page-wrap,
.data-page-wrap {
    max-width: 600px;
    margin: 0 auto;
    padding: 8px 0 48px;
}

.data-page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
}

.data-page-header-text { min-width: 0; flex: 1; }

.data-page-title {
    margin: 0 0 6px;
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
}

.data-page-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
}

.data-refresh-btn {
    flex-shrink: 0;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.data-page-body { margin-top: 0; }

.data-profile-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 18px;
    border-radius: 14px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
}

.data-steam-avatar,
.my-data-steam-avatar {
    width: 80px;
    height: 80px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    flex-shrink: 0;
    display: block;
}

.data-steam-meta { min-width: 0; flex: 1; }

.data-steam-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.25;
}

.data-steam-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
}

.data-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-color);
    font-size: 0.82rem;
    color: var(--text-secondary);
}

.data-chip-label { opacity: 0.75; }

.data-chip strong {
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    font-weight: 650;
}

.data-stats-row {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 12px;
    margin-top: 14px;
}

.data-stat-card {
    margin: 0;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    min-width: 0;
}

.data-stat-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 6px;
}

.data-stat-value {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
}

.data-stat-card--achv .data-stat-value strong {
    font-size: 1.35rem;
    font-weight: 700;
}

.my-data-achv-bar {
    margin-top: 10px;
    height: 6px;
    border-radius: 999px;
    background: rgba(255,255,255,0.08);
    overflow: hidden;
}

.my-data-achv-bar-fill {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: inherit;
    background: linear-gradient(90deg, #66c0f4, #1b9cf0);
    transition: width 0.35s var(--ease-out, ease);
}

.my-data-achv-pct {
    display: block;
    margin-top: 6px;
    font-size: 0.78rem;
    color: var(--text-muted);
}

.data-achv-section {
    margin-top: 22px;
}

.data-achv-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    padding: 0 2px;
}

.data-achv-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--text-primary);
}

.data-achv-count {
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.data-achievements-list {
    border-radius: 12px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    overflow: hidden;
}

.data-achievements-list .achv-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.data-achievements-list .achv-list {
    display: flex;
    flex-direction: column;
}

.data-achievements-list .achv-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    border: none;
    border-radius: 0;
    background: transparent;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    min-width: 0;
}

.data-achievements-list .achv-item:last-child {
    border-bottom: none;
}

.data-achievements-list .achv-item--locked {
    opacity: 1;
    background: rgba(0,0,0,0.12);
}

.data-achievements-list .achv-item--locked .achv-icon {
    filter: grayscale(1) brightness(0.75);
    opacity: 0.7;
}

.data-achievements-list .achv-item--locked .achv-name {
    color: var(--text-secondary);
}

.data-achievements-list .achv-item--locked .achv-desc,
.data-achievements-list .achv-item--locked .achv-unlock {
    color: var(--text-muted);
}

.data-achievements-list .achv-icon {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
    background: #000;
    border: 1px solid var(--border-color);
}

.data-achievements-list .achv-meta {
    min-width: 0;
    flex: 1;
}

.data-achievements-list .achv-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
}

.data-achievements-list .achv-desc {
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
}

.data-achievements-list .achv-unlock {
    margin-top: 6px;
    font-size: 0.72rem;
    color: #66c0f4;
}

.data-achievements-list .achv-item--locked .achv-unlock {
    color: var(--text-muted);
}

.data-achievements-list .achv-empty {
    padding: 28px 16px;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
}

.data-achievements-list .achv-toggle {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 0.8rem;
    cursor: pointer;
}

.data-achievements-list .achv-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
}

.data-steam-unbound { margin-top: 4px; }

.data-unbound-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 28px 22px;
    border-radius: 14px;
    background: var(--bg-tertiary);
    border: 1px dashed var(--border-color);
    color: var(--text-secondary);
}

.data-unbound-card > i {
    font-size: 1.6rem;
    opacity: 0.85;
    color: #66c0f4;
}

.data-unbound-card p {
    margin: 0;
    font-size: 0.95rem;
}

.btn-sm {
    padding: 6px 10px;
    font-size: 0.82rem;
}

@media screen and (max-width: 560px) {
    .data-stats-row {
        grid-template-columns: 1fr;
    }
    .data-page-header {
        flex-wrap: wrap;
    }
}



/* ===== 个人信息页（全宽封面，贴顶栏） ===== */
.page.page-profile {
    max-width: none;
    padding: 0;
    /* Cancel .main-content top padding so cover sits flush under #appTopbar */
    margin-top: -36px;
}

.page-profile {
    padding: 0;
}

.profile-page-wrap {
    max-width: none;
    margin: 0;
}

.profile-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 1;
    height: auto;
    min-height: 220px;
    max-height: 380px;
    border-radius: 0;
    overflow: hidden;
    background: linear-gradient(135deg, #1a1f2e 0%, #2a3148 45%, #1e2433 100%);
    border: none;
    border-bottom: 1px solid var(--border-color);
    background-size: cover;
    background-position: center;
}

.profile-cover-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 13px;
    pointer-events: none;
}

.profile-cover.has-image .profile-cover-placeholder {
    display: none;
}

.profile-page-body {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 clamp(18px, 4vw, 28px) 48px;
}

/* Avatar overlaps cover; nickname/meta stay below cover. Shared left edge. */
.profile-identity {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    margin-top: -56px;
    position: relative;
}

.profile-identity-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
}

.profile-page-avatar {
    display: block;
    flex: 0 0 auto;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg-primary, #12141c);
    background: var(--bg-tertiary);
    box-shadow: 0 6px 20px rgba(0,0,0,.4);
}

.profile-page-actions {
    flex: 0 0 auto;
    padding-bottom: 8px;
}

.profile-page-actions .btn {
    white-space: nowrap;
}

.profile-identity-meta {
    min-width: 0;
    /* Match avatar's visual left edge (avatar border is 4px, box starts at same inset) */
    padding: 0;
    margin: 0;
}

.profile-home {
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--border-color);
}

.profile-home-header {
    margin-bottom: 18px;
}

.profile-home-title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
}

.profile-home-desc {
    margin: 6px 0 0;
    font-size: 0.92rem;
    color: var(--text-secondary, #999);
}

.profile-home-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 22px;
}

.profile-home-tab {
    appearance: none;
    border: 1px solid var(--border-color);
    background: rgba(255,255,255,0.03);
    color: var(--text-secondary, #aaa);
    border-radius: 999px;
    padding: 8px 18px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.profile-home-tab:hover {
    color: var(--text-primary);
    border-color: rgba(255,255,255,0.22);
}

.profile-home-tab.is-active {
    background: rgba(255,255,255,0.1);
    color: var(--text-primary);
    border-color: rgba(255,255,255,0.28);
}

.profile-home-tab-count {
    display: inline-block;
    margin-left: 4px;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
}

.profile-home-panels {
    min-height: 160px;
}

.profile-home-panel[hidden] {
    display: none !important;
}

.profile-works-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.profile-work-card {
    display: grid;
    grid-template-columns: minmax(140px, 28%) 1fr;
    gap: 0;
    align-items: stretch;
    min-height: 148px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.profile-work-card:hover,
.profile-work-card:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.22);
    box-shadow: 0 12px 32px rgba(0,0,0,0.28);
    outline: none;
}

.profile-work-cover {
    position: relative;
    min-height: 148px;
    background: linear-gradient(145deg, rgba(80,90,120,0.45), rgba(30,34,48,0.9));
    overflow: hidden;
}

.profile-work-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.profile-work-cover-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.55);
    background:
        radial-gradient(circle at 30% 30%, rgba(120,150,220,0.35), transparent 55%),
        linear-gradient(145deg, rgba(60,70,100,0.55), rgba(20,24,36,0.95));
}

.profile-work-play {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.25);
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
}

.profile-work-play::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent #fff;
}

.profile-work-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 22px 24px;
    min-width: 0;
}

.profile-work-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.profile-work-summary {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-secondary, #aaa);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.profile-work-meta {
    margin: 4px 0 0;
    font-size: 0.82rem;
    color: var(--text-muted, #888);
}

.profile-works-empty {
    text-align: center;
    padding: 48px 20px;
    border-radius: 16px;
    border: 1px dashed rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.02);
    color: var(--text-muted, #888);
}

.profile-works-empty-title {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--text-secondary, #bbb);
    margin-bottom: 6px;
}

.profile-works-empty-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted, #888);
}

@media (max-width: 720px) {
    .profile-work-card {
        grid-template-columns: 1fr;
        min-height: 0;
    }
    .profile-work-cover {
        min-height: 160px;
        aspect-ratio: 16 / 9;
    }
    .profile-work-body {
        padding: 16px 18px 18px;
    }
    .profile-work-title {
        font-size: 1.08rem;
    }
}


.profile-page-nickname {
    margin: 0 0 4px;
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
}

.profile-page-username {
    margin: 0 0 10px;
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.profile-page-bio {
    margin: 0 0 10px;
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.5;
    white-space: pre-wrap;
}

.profile-page-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.profile-page-facts span {
    display: inline-flex;
    align-items: center;
    gap: 0;
}

/* 编辑资料弹窗：封面预览与表单 */
.edit-profile-modal-content {
    width: min(480px, 94vw);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
}
.edit-profile-body {
    overflow-y: auto;
    padding: 16px 20px 8px;
}
.edit-profile-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 12px 20px 16px;
    border-top: 1px solid var(--border-color);
}
.edit-profile-label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 8px;
}
.edit-profile-cover-row {
    margin-bottom: 18px;
}
.edit-profile-cover-preview {
    border-radius: 10px;
    border: 1px dashed var(--border-color);
    background: var(--bg-tertiary);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    aspect-ratio: 3 / 1;
    height: auto;
    min-height: 96px;
}
.edit-profile-cover-preview.has-image .edit-profile-cover-hint {
    display: none;
}
.edit-profile-cover-hint {
    color: var(--text-secondary);
    font-size: 13px;
}
.edit-profile-cover-actions {
    display: flex;
    gap: 8px;
}
.edit-profile-avatar-row {
    margin-bottom: 16px;
}
.edit-profile-avatar-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
}
.edit-profile-avatar-wrap img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-color);
}
.edit-profile-body .form-group {
    margin-bottom: 14px;
}
.edit-profile-body .form-group input,
.edit-profile-body .form-group select,
.edit-profile-body .form-group textarea {
    width: 100%;
    max-width: 340px;
}
.edit-profile-body textarea {
    resize: vertical;
    min-height: 72px;
}
.edit-profile-body .form-hint {
    margin: 6px 0 0;
    font-size: 12px;
    color: var(--text-secondary);
}
.edit-profile-body .char-count {
    max-width: 340px;
    text-align: right;
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 4px;
}

@media screen and (max-width: 640px) {
    .profile-cover {
        min-height: 160px;
        max-height: 240px;
    }
    .profile-page-avatar {
        width: 88px;
        height: 88px;
    }
    .profile-identity {
        margin-top: -44px;
    }
}

@media screen and (max-width: 480px) {
    .page.page-profile {
        margin-top: -20px;
    }
}


.tap-nickname {
    cursor: pointer;
}
.tap-nickname:hover {
    text-decoration: underline;
}
.profile-name {
    cursor: pointer;
}
.profile-name:hover {
    text-decoration: underline;
}
